{
  "name": "censai",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:integrity": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand tests/integrity.test.js",
    "check": "npm run lint && npm test && npm run build",
    "ideas:intake": "node scripts/ideas/intake-check.mjs",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand",
    "dev": "concurrently -k -s first \"node server.js\" \"node scripts/dev-client-after-api.mjs\"",
    "dev:client": "npx vite",
    "dev:server": "node server.js",
    "build": "npx vite build",
    "build:automation": "npx vite build && node -e \"const fs=require('fs');const p=require('path');const d='dist';if(fs.existsSync(p.join(d,'index.html')))fs.unlinkSync(p.join(d,'index.html'));fs.renameSync(p.join(d,'automation.html'),p.join(d,'index.html'));console.log('automation.html -> index.html (offer page root)');\"",
    "perf:audit": "node scripts/perf-audit.mjs",
    "preview": "npx vite preview",
    "kill": "powershell -NoProfile -Command \"Get-Process node -ErrorAction SilentlyContinue | Stop-Process -Force; Write-Host 'killed all node processes'\"",
    "sandbox:build": "docker build -f docker/sandbox.Dockerfile -t homebase-sandbox:latest .",
    "window:list": "node scripts/window-sdk.mjs list",
    "window:validate": "node scripts/window-sdk.mjs validate",
    "window:scaffold": "node scripts/window-sdk.mjs scaffold",
    "window:new": "node scripts/window-sdk.mjs new",
    "window:lab": "npx vite --open /window-lab.html",
    "lint": "eslint .",
    "security": "node scripts/security-tripwires.mjs",
    "check:provenance": "node scripts/check-ai-provenance.mjs",
    "security:ai": "node scripts/ai-security-scanner.mjs",
    "gemini:dispatch": "node scripts/gemini-dispatch-orchestrator.mjs",
    "gemini:dispatch:doctor": "node scripts/gemini-dispatch-doctor.mjs",
    "gemini:dispatch:run": "node scripts/gemini-dispatch-orchestrator.mjs --execute",
    "gemini:dispatch:overnight": "node scripts/gemini-dispatch-overnight.mjs",
    "jules:overnight:tick": "node scripts/jules-overnight.mjs",
    "jules:overnight": "node scripts/jules-overnight.mjs --watch",
    "window:sync": "node scripts/window-sync.mjs",
    "window:check": "node scripts/window-sync.mjs --check"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@google/genai": "^2.6.0",
    "@kubernetes/client-node": "^1.4.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "cors": "^2.8.6",
    "dom-to-image-more": "^3.7.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "eslint-plugin-ai-debt": "file:./tools/eslint-plugin-ai-debt",
    "framer-motion": "^12.40.0",
    "googleapis": "^172.0.0",
    "html2canvas": "^1.4.1",
    "lru-cache": "^11.5.1",
    "node-pty": "^1.1.0",
    "pg": "^8.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "babel-jest": "^30.4.1",
    "concurrently": "^10.0.3",
    "eslint": "^8.57.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.15",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.14"
  },
  "overrides": {
    "qs": "6.15.2",
    "nanoid": "3.3.8",
    "lodash-es": "4.18.1"
  },
  "license": "BUSL-1.1"
}
