{
  "name": "censai",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:integrity": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand tests/integrity.test.js",
    "check": "npm run lint && npm test && npm run build",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand",
    "dev": "concurrently -k -s first \"node server.js\" \"node scripts/dev-client-after-api.mjs\"",
    "dev:client": "npx vite",
    "dev:server": "node server.js",
    "build": "npx vite build",
    "preview": "npx vite preview",
    "kill": "powershell -NoProfile -Command \"Get-Process node -ErrorAction SilentlyContinue | Stop-Process -Force; Write-Host 'killed all node processes'\"",
    "sandbox:build": "docker build -f docker/sandbox.Dockerfile -t censai-sandbox:latest .",
    "window:list": "node scripts/window-sdk.mjs list",
    "window:validate": "node scripts/window-sdk.mjs validate",
    "window:scaffold": "node scripts/window-sdk.mjs scaffold",
    "window:new": "node scripts/window-sdk.mjs new",
    "window:lab": "npx vite --open /window-lab.html",
    "lint": "eslint .",
    "security": "node scripts/security-tripwires.mjs",
    "window:sync": "node scripts/window-sync.mjs",
    "window:check": "node scripts/window-sync.mjs --check"
  },
  "dependencies": {
    "@glyph3d/core": "^0.1.0",
    "@glyph3d/r3f": "^0.1.0",
    "@google/genai": "^2.6.0",
    "@kubernetes/client-node": "^1.4.0",
    "@react-three/fiber": "^9.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cors": "^2.8.6",
    "dom-to-image-more": "^3.7.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "framer-motion": "^12.40.0",
    "googleapis": "^172.0.0",
    "html2canvas": "^1.4.1",
    "lru-cache": "^11.5.1",
    "node-pty": "^1.1.0",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.183.0",
    "ws": "^8.21.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "babel-jest": "^30.4.1",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.15",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.14"
  },
  "overrides": {
    "qs": "6.15.2",
    "nanoid": "3.3.8",
    "lodash-es": "4.18.1"
  },
  "license": "BUSL-1.1"
}
