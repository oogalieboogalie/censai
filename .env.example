# Default chat route: Ollama-compatible local endpoint.
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=minimax-m2.5:cloud

# Database (Postgres) — use the Docker service exposed on 5433.
# 5432 is often occupied by a local Windows Postgres install.
DATABASE_URL=postgresql://censai:censai@127.0.0.1:5433/censai

# Vector DB (Qdrant) — use the Docker service exposed on 6335.
QDRANT_URL=http://127.0.0.1:6335

# Embeddings — uses Ollama by default (ollama pull nomic-embed-text).
# For Cohere: set EMBEDDING_PROVIDER=cohere, COHERE_API_KEY, and EMBEDDING_MODEL=embed-v4.0.
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
COHERE_API_KEY=
COHERE_BASE_URL=
COHERE_EMBEDDING_DIMENSION=

# Security — generate unique secrets for each install.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
JOURNAL_SECRET=

# App + OAuth
APP_ORIGIN=http://localhost:5173
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Google OAuth2 client credentials (required for Calendar / Sheets integration).
# Create a project at https://console.cloud.google.com, enable the Calendar API
# and Sheets API, create an OAuth2 client ID (Web Application), and paste the
# values here.
G_CLIENT_ID=
G_SECRET=
GOOGLE_TOKENS_PATH=.censai-state/google_tokens.json

# Gemini / Google AI Studio key for Gemini chat agents and image generation.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Optional OpenRouter route for users who want OpenAI/Anthropic/xAI/etc.
OPENROUTER_API_KEY=

# Optional Moonshot/Kimi route for selected agents.
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_API_KEY=

# Google Cloud key for non-Gemini APIs. Enable YouTube Data API v3 on this key.
# YOUTUBE_API_KEY wins if both are set.
GOOGLE_CLOUD_API_KEY=
YOUTUBE_API_KEY=

# Mailcow Addon Configuration
MAILCOW_URL=
MAILCOW_API_KEY=

# Linear Addon Configuration
LINEAR_API_KEY=

# Runner (Dangerous execution plane)
# If disabled, agents cannot run tests, lint, or docker commands.
# Local dev defaults to RUNNER_ENABLED=true (local fallback).
# Production defaults to RUNNER_ENABLED=false.
RUNNER_ENABLED=
RUNNER_URL=http://localhost:3003
RUNNER_SECRET=

# Overseer window (optional): hooks an external repo-audit script into the canvas.
# Leave unset to disable — the window will report "not configured".
OVERSEER_SCRIPT_PATH=
OVERSEER_SCRIPT_CWD=
OVERSEER_DEFAULT_REPO=

# Server logging
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_DIR=.censai-state/logs
LOG_RETENTION_DAYS=14
LOG_MAX_BYTES=100mb
LOG_CLEANUP_INTERVAL_HOURS=24
